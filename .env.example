MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
AUTH_SECRET=generate-a-cryptographically-secure-secret

# Admin credentials (server-side only; never prefix these with NEXT_PUBLIC_)
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=replace-with-a-long-random-password

# Transactional email configuration (server-side only)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Sangam Parlour
ADMIN_NOTIFICATION_EMAIL=admin-notification@example.com
